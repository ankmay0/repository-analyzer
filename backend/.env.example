# Copy to backend/.env and fill in. Required for chat; indexing works without it.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown). See src/repo_analyzer/config.py for all settings.
# RA_LLM_MODEL=claude-opus-5-5
# RA_LLM_EFFORT=medium
# RA_DATA_DIR=.data
# RA_CTAGS_PATH=ctags
# RA_SKILLS_DIR=skills
# Ask the model once per repository at index time for per-endpoint data-flow metadata
# (written next to the JSON index) and give the agent a get_endpoint_metadata tool.
# RA_ENDPOINT_METADATA=false
# Only for the benchmark's json-github approach (read-only access is enough).
# GITHUB_TOKEN=
